# Docker Compose Name for PRIPRE.
COMPOSE_TAG=pripre-temp
# Default deployment is accessible only from this machine.
PRIPRE_BIND_ADDRESS=127.0.0.1
PRIPRE_PORT=8080
# The data directory must already exist and be writable by this uid/gid.
PRIPRE_DATA_DIR=./data
PRIPRE_UID=1000
PRIPRE_GID=1000
# Explicitly opt in to Binance public real-time market data.
PRIPRE_LIVE_ENABLED=false

# Data sources only: HTTP CONNECT proxy; empty means explicit direct access.
# Docker Desktop: http://host.docker.internal:7077
# Native Linux: enable deploy/compose.proxy-host.yaml; bind proxy to a reachable host address.
# Never use 127.0.0.1 for a host proxy from a bridge-network container.
PRIPRE_SOURCE_PROXY=
